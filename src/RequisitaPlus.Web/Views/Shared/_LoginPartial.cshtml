@using Microsoft.AspNetCore.Identity
@using RequisitaPlus.Web.Models
@inject SignInManager<ApplicationUser> SignInManager
<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item user-identity"><span class="nav-link">@User.Identity?.Name</span></li>
    <li class="nav-item">
        <form asp-area="Identity" asp-page="/Account/Logout" method="post">
            <button type="submit" class="nav-link btn btn-link">Sair</button>
        </form>
    </li>
}
else
{
    <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Cadastrar</a></li>
    <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Entrar</a></li>
}
</ul>
