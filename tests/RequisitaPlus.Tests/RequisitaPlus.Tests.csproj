<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <StartupObject>RequisitaPlus.Tests.AutoGenerated.XunitAutoGeneratedEntryPoint</StartupObject>
  </PropertyGroup>
  <!-- A separate executable, never selected by normal build/test. Reuses restored dependencies. -->
  <PropertyGroup Condition="'$(RequisitaPlusMigrationExecutor)' == 'true'">
    <StartupObject>RequisitaPlus.Tests.Operations.MigrationExecutorProgram</StartupObject>
    <AssemblyName>RequisitaPlus.MigrationExecutor</AssemblyName>
    <OutputPath>bin/MigrationExecutor/$(Configuration)/</OutputPath>
    <IntermediateOutputPath>obj/MigrationExecutor/$(Configuration)/$(TargetFramework)/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/RequisitaPlus.Web/RequisitaPlus.Web.csproj" />
  </ItemGroup>
</Project>
